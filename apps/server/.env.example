# Server
PORT=4001

# Neo4j (same as Noos)
NEO4J_URI=bolt://localhost:7690
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# JWT (must match Noos for shared auth)
JWT_SECRET=your-jwt-secret

# Comma-separated browser origins allowed by both REST and Socket.IO.
# A single origin remains valid. Social's local Express/Vite dev server uses 5000.
CORS_ORIGIN=http://localhost:5000

# Web Push (OpenChat-3fw). Generate once with: npx web-push generate-vapid-keys
# Public key is also exposed to the client via GET /api/push/vapid-public-key.
# VAPID_SUBJECT must be a mailto: or https:// URI (Web Push spec requirement).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@globalbr.ai

# Google OAuth (OpenChat-hwi). The "Noos / OpenChat" web client lives in GCP
# project boreal-conquest-464203-v2. Get the secret from
# M5:~/.config/openchat-accounts.json (mode 600). When unset, the
# /api/auth/google/* endpoints return 503 and the Google button on the
# LoginPage will fail at click time — leave them empty in dev if you only
# want to exercise the Noos SSO path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Feedback -> WorldIssueTracker (oc8.3). The /api/feedback route creates a WIT
# issue from in-app feedback using this agent key (X-Agent-Key). Unset = the
# route returns 503 and the mobile "Send feedback" row shows a graceful error.
# Mint via the WIT UI (worldissuetracker.com) or reuse ~/.config/wit/agent-key.
WIT_AGENT_KEY=
# Optional overrides (defaults are correct for prod):
# WIT_API_BASE=https://sthqnyjniclvnflfkyio.supabase.co/functions/v1
# WIT_SITE_URL=https://worldissuetracker.com
