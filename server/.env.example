# Server
PORT=4001

# Neo4j (same as Noos)
NEO4J_URI=bolt://localhost:7690
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# JWT (must match Noos for shared auth)
JWT_SECRET=your-jwt-secret

# Web Push (OpenChat-3fw). Generate once with: npx web-push generate-vapid-keys
# Public key is also exposed to the client via GET /api/push/vapid-public-key.
# VAPID_SUBJECT must be a mailto: or https:// URI (Web Push spec requirement).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@globalbr.ai
